 	}
 }
 
+func TestSnellUserKeyIsWrittenInTCPAndUDPHeaders(t *testing.T) {
+	clientID := []byte("alice-key")
+
+	tcpConn := &bufferConn{}
+	if err := WriteHeaderWithReuseAndClientID(tcpConn, "example.com", 443, Version6, true, clientID); err != nil {
+		t.Fatal(err)
+	}
+	wantTCP := []byte{Version, CommandConnectV2, byte(len(clientID))}
+	wantTCP = append(wantTCP, clientID...)
+	wantTCP = append(wantTCP, byte(len("example.com")))
+	wantTCP = append(wantTCP, "example.com"...)
+	wantTCP = append(wantTCP, 0x01, 0xbb)
+	if !bytes.Equal(tcpConn.Bytes(), wantTCP) {
+		t.Fatalf("TCP header = %x, want %x", tcpConn.Bytes(), wantTCP)
+	}
+
+	udpConn := &bufferConn{}
+	if err := WriteUDPHeaderWithClientID(udpConn, Version6, clientID); err != nil {
+		t.Fatal(err)
+	}
+	wantUDP := append([]byte{Version, CommandUDP, byte(len(clientID))}, clientID...)
+	if !bytes.Equal(udpConn.Bytes(), wantUDP) {
+		t.Fatalf("UDP header = %x, want %x", udpConn.Bytes(), wantUDP)
+	}
+}
+
+func TestSnellUserKeyRejectsOversizedClientID(t *testing.T) {
+	clientID := make([]byte, 256)
+	if err := WriteHeaderWithReuseAndClientID(&bufferConn{}, "example.com", 443, Version6, false, clientID); err == nil {
+		t.Fatal("TCP header accepted a client ID longer than 255 bytes")
+	}
+	if err := WriteUDPHeaderWithClientID(&bufferConn{}, Version6, clientID); err == nil {
+		t.Fatal("UDP header accepted a client ID longer than 255 bytes")
+	}
+}
+
+func TestSnellEmptyClientIDHeadersRemainCompatible(t *testing.T) {
+	tcpConn := &bufferConn{}
+	if err := WriteHeaderWithReuse(tcpConn, "example.com", 443, Version6, true); err != nil {
+		t.Fatal(err)
+	}
+	if got, want := tcpConn.Bytes()[2], byte(0); got != want {
+		t.Fatalf("legacy TCP client ID length = %d, want %d", got, want)
+	}
+
+	udpConn := &bufferConn{}
+	if err := WriteUDPHeader(udpConn, Version6); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(udpConn.Bytes(), []byte{Version, CommandUDP, 0}) {
+		t.Fatalf("legacy UDP header = %x, want empty client ID", udpConn.Bytes())
+	}
+}
+
