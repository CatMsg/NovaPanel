+package socks5
+
+import (
+	"testing"
+
+	"github.com/enfein/mieru/v3/pkg/appctl/appctlpb"
+)
+
+func TestNovaPanelBridgeProxyAddsAuthenticatedUserWithoutMutatingConfig(t *testing.T) {
+	t.Setenv("MITA_NOVAPANEL_BRIDGE_AUTH", "1")
+	name := "alice"
+	hash := "hashed-password"
+	proxy := &appctlpb.EgressProxy{}
+	users := map[string]*appctlpb.User{name: {Name: &name, HashedPassword: &hash}}
+
+	got := novaPanelBridgeProxy(proxy, name, users)
+	if got == proxy {
+		t.Fatal("expected a per-connection proxy copy")
+	}
+	if got.GetSocks5Authentication().GetUser() != name || got.GetSocks5Authentication().GetPassword() != hash {
+		t.Fatalf("unexpected bridge credentials: %#v", got.GetSocks5Authentication())
+	}
+	if proxy.GetSocks5Authentication() != nil {
+		t.Fatal("shared egress proxy was mutated")
+	}
+}
+
+func TestNovaPanelBridgeProxyIsOptIn(t *testing.T) {
+	name := "alice"
+	hash := "hashed-password"
+	proxy := &appctlpb.EgressProxy{}
+	users := map[string]*appctlpb.User{name: {Name: &name, HashedPassword: &hash}}
+
+	if got := novaPanelBridgeProxy(proxy, name, users); got != proxy {
+		t.Fatal("bridge authentication must remain disabled without the environment flag")
+	}
+}
