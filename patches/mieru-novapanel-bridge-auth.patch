+func novaPanelBridgeProxy(proxy *appctlpb.EgressProxy, userName string, users map[string]*appctlpb.User) *appctlpb.EgressProxy {
+	if os.Getenv("MITA_NOVAPANEL_BRIDGE_AUTH") != "1" || proxy == nil || userName == "" {
+		return proxy
+	}
+	user := users[userName]
+	if user == nil || user.GetHashedPassword() == "" {
+		return proxy
+	}
+	proxyCopy := *proxy
+	password := user.GetHashedPassword()
+	proxyCopy.Socks5Authentication = &appctlpb.Auth{User: &userName, Password: &password}
+	return &proxyCopy
+}
