+func TestSessionInfoIncludesAuthenticatedUser(t *testing.T) {
+	session := NewSession(1, false, 1400, nil, nil)
+	username := "alice"
+	session.userName.Store(&username)
+	info := session.ToSessionInfo()
+	if got := info.GetUserName(); got != username {
+		t.Fatalf("SessionInfo userName = %q, want %q", got, username)
+	}
+	encoded, err := json.Marshal(info)
+	if err != nil {
+		t.Fatalf("marshal SessionInfo: %v", err)
+	}
+	if !strings.Contains(string(encoded), `"userName":"alice"`) {
+		t.Fatalf("JSON SessionInfo does not expose userName: %s", encoded)
+	}
+}
